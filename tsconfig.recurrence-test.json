{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./node_modules/.tmp/recurrence-tests",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "src/pages/utility/calendar/types.ts",
    "src/pages/utility/calendar/utils/date.ts",
    "src/pages/utility/calendar/utils/recurrence.ts"
  ]
}
